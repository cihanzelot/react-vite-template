{
  "name": "react-vite-template",
  "version": "1.0.0",
  "private": true,
  "description": "Minimal, modern, opinionated React + Vite template with strict TypeScript, Tailwind CSS v4, Vitest, and Oxc tooling",
  "keywords": [
    "knip",
    "oxfmt",
    "oxlint",
    "react",
    "tailwindcss",
    "template",
    "vite",
    "vitest"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gauurof/react-vite-template"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm knip",
    "check:ci": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test:coverage && pnpm knip",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "fix": "pnpm lint:fix && pnpm format",
    "preview": "vite preview",
    "knip": "knip"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.2",
    "happy-dom": "^20.14.5",
    "knip": "^6.38.0",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^7.0.2003",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": "24.x",
    "pnpm": "=12.6.0"
  },
  "packageManager": "pnpm@12.6.0"
}
